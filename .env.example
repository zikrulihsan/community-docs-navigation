# Supabase — dua nilai ini aman untuk browser (publishable key dilindungi RLS).
# Prefix VITE_ wajib supaya Vite menyertakannya ke bundle client.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_with_your_key

# JANGAN taruh secret/service-role key di sini: tidak ada server, semua env VITE_ ikut ke browser.
