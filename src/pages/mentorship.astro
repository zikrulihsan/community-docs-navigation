---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import JoinCta from '../components/JoinCta.astro';

const ADMIN_WA = '6282338588078';

const mentors = (await getCollection('mentors')).sort(
  (a, b) => Number(b.data.available) - Number(a.data.available) || a.data.name.localeCompare(b.data.name),
);

/** Pesan WhatsApp ke admin, sudah terisi sebagian biar anggota tinggal lengkapi problemnya. */
const waLink = (mentor?: string) => {
  const text = [
    'Halo admin SWE Growth 👋',
    '',
    'Saya mau ikut sesi mentorship.',
    '',
    `Mentor yang dituju: ${mentor ?? 'belum ada preferensi, mohon dibantu carikan'}`,
    'Problem/konteks saya: ',
  ].join('\n');
  return `https://wa.me/${ADMIN_WA}?text=${encodeURIComponent(text)}`;
};

const steps = [
  {
    n: '1',
    t: 'Lihat daftar mentor',
    d: 'Cek siapa yang topiknya paling nyambung sama masalahmu. Belum nemu yang cocok? Nggak apa-apa, lanjut ke langkah 2.',
  },
  {
    n: '2',
    t: 'Hubungi admin',
    d: 'Ceritakan problemnya, lalu sebutkan mau sama mentor siapa — atau bilang saja belum ada preferensi.',
  },
  {
    n: '3',
    t: 'Admin cocokkan',
    d: 'Admin menghubungkan kamu dengan mentor yang pas dan bantu atur jadwal sesinya.',
  },
];
---
<Base
  title="Mentorship — SWE Growth"
  description="Program mentorship SWE Growth. Lihat daftar mentor, lalu hubungi admin untuk dicocokkan — gratis untuk anggota komunitas."
>
  <PageHero
    badge="Mentorship"
    title="Nggak perlu jalan sendirian"
    lead="Belajar dari yang sudah lebih dulu lewat jalan yang sama. Ceritakan problemmu ke admin, nanti kami cocokkan dengan mentor yang pas."
  />

  <section class="block">
    <div class="wrap">
      <h2 class="section-title">Cara kerjanya</h2>
      <div class="card-grid">
        {steps.map((s) => (
          <div class="card">
            <span class="step-n">{s.n}</span>
            <h3>{s.t}</h3>
            <p>{s.d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="block">
    <div class="wrap">
      <h2 class="section-title">Daftar mentor</h2>
      {mentors.length === 0 ? (
        <div class="empty-note">Daftar mentor lagi disusun. Sementara, langsung hubungi admin aja ya.</div>
      ) : (
        <div class="card-grid">
          {mentors.map((m) => (
            <div class="card">
              <span class={m.data.available ? 'chip green' : 'chip'}>
                {m.data.available ? 'tersedia' : 'sedang penuh'}
              </span>
              <h3>{m.data.name}</h3>
              <p>{m.data.role}{m.data.company ? ` · ${m.data.company}` : ''}</p>
              <div class="topics">
                {m.data.topics.map((t) => <span class="chip">{t}</span>)}
              </div>
              <span class="spacer"></span>
              <div class="card-actions">
                {m.data.available ? (
                  <a class="btn btn-primary sm" href={waLink(m.data.name)} target="_blank" rel="noopener">
                    Ajukan ke admin
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
                  </a>
                ) : (
                  <span class="unavailable">Lagi penuh — coba mentor lain dulu ya</span>
                )}
                {m.data.linkedin && (
                  <a class="mentor-link" href={m.data.linkedin} target="_blank" rel="noopener">LinkedIn →</a>
                )}
              </div>
            </div>
          ))}
        </div>
      )}
    </div>
  </section>

  <section class="block">
    <div class="wrap">
      <div class="no-pref">
        <div>
          <h2>Belum ada preferensi mentor?</h2>
          <p>
            Santai, itu normal. Langsung hubungi admin dan ceritakan aja apa yang lagi ganjel —
            nanti kami carikan mentor yang paling nyambung sama kondisimu.
          </p>
        </div>
        <a class="btn btn-primary" href={waLink()} target="_blank" rel="noopener">
          Hubungi admin
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </a>
      </div>
    </div>
  </section>

  <JoinCta />
</Base>

<style>
  .step-n {
    display: grid; place-items: center; width: 32px; height: 32px; border-radius: 50%;
    background: var(--navy); color: var(--green-br); font-family: var(--font-mono); font-size: 0.85rem; font-weight: 700;
  }
  .topics { display: flex; flex-wrap: wrap; gap: 6px; }
  .card-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 14px; margin-top: 4px; }
  .btn.sm { padding: 9px 17px; font-size: 0.88rem; }
  .unavailable { color: var(--ink-faint); font-size: 0.88rem; }
  .mentor-link { color: var(--green-deep); font-size: 0.88rem; font-weight: 600; }
  .no-pref {
    display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 20px;
    background: var(--bg-2); border: 1px solid var(--line); border-radius: var(--r); padding: 26px;
  }
  .no-pref h2 { font-size: 1.25rem; margin-bottom: 6px; }
  .no-pref p { color: var(--ink-soft); font-size: 0.95rem; max-width: 56ch; }
</style>
