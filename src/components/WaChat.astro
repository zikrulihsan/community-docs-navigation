const first = slides[0];
const subText = (s: Slide) =>
  `${s.c ? s.c.toLocaleString('id-ID') + ' anggota' : 'grup baru'} · ${s.online} online`;
const nmClass = (m: Msg) => (m.host ? 'host' : m.bot ? 'bot' : m.cl || '');
---
<div class="wa-slider">
  <div class="wa">
    <div class="wa-inner">
      <div class="wa-head">
        <span class="mark" id="waMark" set:html={first.ic}></span>
        <div class="g-meta">
          <div class="g-name" id="waName">{first.n}</div>
          <div class="g-sub" id="waSub">{subText(first)}</div>
        </div>
      </div>
      <div class="wa-body" id="waBody">
        {first.msgs.map((m) => (
          <div class={`bub in${m.me ? ' me' : ''}${m.host ? ' host' : ''}${m.bot ? ' bot' : ''}`}>
            {!m.me && <span class={`nm ${nmClass(m)}`}>{m.n}</span>}
            {m.t}
            <span class="tm">{m.tm}</span>
          </div>
        ))}
      </div>
      <div class="wa-type">
        <div class="field">Ketik pesan…</div>
        <span class="send"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M3 20l18-8L3 4l0 6 12 2-12 2z"/></svg></span>
      </div>
    </div>
  </div>
  <div class="wa-nav">
    <button class="wa-btn" id="waPrev" type="button" aria-label="Grup sebelumnya"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M15 6l-6 6 6 6"/></svg></button>
    <div class="wa-dots" id="waDots" role="tablist" aria-label="Pilih grup">
      {slides.map((s, i) => (
        <button type="button" role="tab" data-i={i} class={i === 0 ? 'on' : undefined} aria-label={s.n}></button>
      ))}
    </div>
    <button class="wa-btn" id="waNext" type="button" aria-label="Grup berikutnya"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6"/></svg></button>
  </div>
</div>

<script is:inline define:vars={{ slides }}>
  (function () {
    var body = document.getElementById('waBody');
    var name = document.getElementById('waName');
    var sub = document.getElementById('waSub');
    var mark = document.getElementById('waMark');
    var dots = document.getElementById('waDots');
    if (!body || !dots) return;

    var dotEls = [].slice.call(dots.children);
    var reduce = matchMedia('(prefers-reduced-motion: reduce)');
    var gi = 0, timer = null, bubbleTimers = [], visible = true;

    function render(i) {
      bubbleTimers.forEach(clearTimeout);
      bubbleTimers = [];
      var g = slides[i];
      mark.innerHTML = g.ic;
      name.textContent = g.n;
      sub.textContent = (g.c ? g.c.toLocaleString('id-ID') + ' anggota' : 'grup baru') + ' · ' + g.online + ' online';
      body.textContent = '';
      dotEls.forEach(function (d, di) { d.classList.toggle('on', di === i); });
      g.msgs.forEach(function (m, mi) {
        var el = document.createElement('div');
        el.className = 'bub' + (m.me ? ' me' : '') + (m.host ? ' host' : '') + (m.bot ? ' bot' : '');
        if (!m.me) {
          var nm = document.createElement('span');
          nm.className = 'nm ' + (m.host ? 'host' : m.bot ? 'bot' : m.cl || '');
          nm.textContent = m.n;
          el.appendChild(nm);
        }
        el.appendChild(document.createTextNode(m.t));
        var tm = document.createElement('span');
        tm.className = 'tm';
        tm.textContent = m.tm;
        el.appendChild(tm);
        body.appendChild(el);
        if (reduce.matches) {
          el.classList.add('in');
        } else {
          bubbleTimers.push(setTimeout(function () { el.classList.add('in'); }, 90 + mi * 340));
        }
      });
    }

    function goTo(i, fromUser) {
      gi = (i + slides.length) % slides.length;
      render(gi);
      if (fromUser) restart();
    }

    function restart() {
      clearInterval(timer);
      // Jangan auto-putar kalau user minta gerakan minimal, atau slider lagi nggak kelihatan.
      if (reduce.matches || !visible) return;
      timer = setInterval(function () { goTo(gi + 1); }, 5200);
    }

    document.getElementById('waPrev').addEventListener('click', function () { goTo(gi - 1, true); });
    document.getElementById('waNext').addEventListener('click', function () { goTo(gi + 1, true); });
    dots.addEventListener('click', function (e) {
      var b = e.target.closest('button');
      if (b) goTo(+b.dataset.i, true);
    });

    // Hemat kerja: berhenti kalau tab disembunyikan atau slider ke-scroll keluar layar.
    document.addEventListener('visibilitychange', function () {
      visible = !document.hidden;
      restart();
    });
    if ('IntersectionObserver' in window) {
      new IntersectionObserver(function (entries) {
        visible = entries[0].isIntersecting && !document.hidden;
        restart();
      }, { threshold: 0 }).observe(body);
    }
    reduce.addEventListener('change', restart);

    restart();
  })();
</script>

<!--
  Style-nya sengaja global, bukan ter-scope: bubble chat dibuat lewat JavaScript
  saat ganti slide, jadi elemennya tidak punya atribut scope Astro dan CSS
  ter-scope tidak akan kena. Semua selector dikurung di bawah `.wa-slider`
  supaya tetap tidak bocor ke komponen lain.
-->
<style is:global>
  .wa-slider { max-width: 430px; margin-left: auto; }
  .wa-slider .wa {
    background: var(--paper); border-radius: 26px; padding: 12px;
    box-shadow: 0 2px 4px oklch(0.3 0.02 250 / .06), 0 30px 60px -22px oklch(0.3 0.04 250 / .35);
    border: 1px solid var(--line);
    transform: rotate(0.7deg);
    max-width: 430px; margin-left: auto;
  }
  .wa-slider .wa-inner { border-radius: 18px; overflow: hidden; background: oklch(0.945 0.012 140); }
  .wa-slider .wa-head { display: flex; align-items: center; gap: 12px; padding: 13px 15px; background: var(--green-deep); color: #fff; }
  .wa-slider .wa-head .mark {
    width: 38px; height: 38px; flex: none; display: grid; place-items: center; border-radius: 50%;
    background: var(--navy); color: var(--green-br); box-shadow: 0 0 0 2px oklch(1 0 0 / .2);
  }
  .wa-slider .wa-head .mark svg { width: 60%; height: 60%; }
  .wa-slider .wa-head .g-name { font-weight: 700; font-size: 0.96rem; line-height: 1.2; }
  .wa-slider .wa-head .g-sub { font-size: 0.74rem; color: oklch(0.95 0.03 150); margin-top: 2px; }
  .wa-slider .wa-head .g-meta { flex: 1; min-width: 0; }
  .wa-slider .wa-body {
    padding: 16px 14px 18px; height: 452px; display: flex; flex-direction: column;
    justify-content: flex-end; gap: 9px; overflow: hidden;
    background-image: radial-gradient(oklch(0.86 0.02 140 / .55) 1px, transparent 1px);
    background-size: 18px 18px;
  }
  .wa-slider .bub {
    max-width: 82%; padding: 8px 12px 7px; border-radius: 13px; font-size: 0.9rem; line-height: 1.38;
    background: var(--paper); box-shadow: 0 1px 1px oklch(0.3 0.02 250 / .08); color: var(--ink);
    border-top-left-radius: 4px; align-self: flex-start; position: relative;
    opacity: 0; transform: translateY(10px) scale(.98);
  }
  .wa-slider .bub.in { animation: wa-bubin .45s cubic-bezier(.2,.8,.3,1) forwards; }
  @keyframes wa-bubin { to { opacity: 1; transform: none; } }
  .wa-slider .bub .nm { font-weight: 700; font-size: 0.76rem; display: block; margin-bottom: 1px; }
  .wa-slider .bub .tm { font-family: var(--font-mono); font-size: 0.6rem; color: var(--ink-faint); float: right; margin: 4px 0 -2px 8px; }
  .wa-slider .bub.me { align-self: flex-end; background: oklch(0.88 0.09 150); border-top-left-radius: 13px; border-top-right-radius: 4px; }
  .wa-slider .bub.host { box-shadow: 0 1px 1px oklch(0.3 0.02 250 / .08), inset 0 0 0 1.5px oklch(0.66 0.155 152 / .4); }
  .wa-slider .nm.c1 { color: oklch(0.55 0.16 20); }
  .wa-slider .nm.c2 { color: oklch(0.52 0.15 280); }
  .wa-slider .nm.c3 { color: oklch(0.55 0.14 200); }
  .wa-slider .nm.c4 { color: oklch(0.55 0.14 60); }
  .wa-slider .nm.host { color: var(--green-deep); }
  .wa-slider .nm.bot { color: oklch(0.52 0.13 195); }
  .wa-slider .nm.bot::after {
    content: "BOT"; font-family: var(--font-mono); font-size: 0.52rem; font-weight: 700; letter-spacing: .06em;
    color: #fff; background: oklch(0.6 0.1 195); padding: 1px 4px; border-radius: 4px; margin-left: 6px; vertical-align: 1px;
  }
  .wa-slider .bub.bot { background: oklch(0.96 0.025 195); box-shadow: 0 1px 1px oklch(0.3 0.02 250 / .08), inset 0 0 0 1.5px oklch(0.7 0.1 195 / .35); }
  .wa-slider .wa-type { display: flex; align-items: center; gap: 9px; padding: 11px 15px; background: var(--paper); border-top: 1px solid var(--line); color: var(--ink-faint); font-size: 0.88rem; }
  .wa-slider .wa-type .field { flex: 1; background: var(--bg-2); border-radius: 100px; padding: 8px 14px; }
  .wa-slider .wa-type .send { width: 34px; height: 34px; border-radius: 50%; background: var(--green); display: grid; place-items: center; color: #fff; }
  .wa-slider .wa-type .send svg { width: 16px; height: 16px; }

  .wa-slider .wa-nav { display: flex; align-items: center; justify-content: center; gap: 14px; margin-top: 18px; }
  .wa-slider .wa-btn {
    flex: none; width: 40px; height: 40px; border-radius: 50%; cursor: pointer;
    display: grid; place-items: center; color: var(--ink-soft);
    background: var(--paper); border: 1px solid var(--line);
    box-shadow: 0 1px 2px oklch(0.3 0.02 250 / .06), 0 8px 18px -12px oklch(0.3 0.04 250 / .4);
    transition: color .18s ease, border-color .18s ease, transform .18s ease, background .18s ease;
  }
  .wa-slider .wa-btn svg { width: 20px; height: 20px; }
  .wa-slider .wa-btn:hover { color: var(--green-deep); border-color: var(--green); transform: translateY(-1px); }
  .wa-slider .wa-btn:active { transform: translateY(0) scale(.95); }
  .wa-slider .wa-dots { display: flex; align-items: center; gap: 7px; }
  .wa-slider .wa-dots button {
    width: 8px; height: 8px; border-radius: 50%; cursor: pointer; padding: 0;
    background: var(--line-2); border: none; transition: background .2s ease, width .2s ease;
  }
  .wa-slider .wa-dots button.on { width: 22px; border-radius: 5px; background: var(--green); }
  .wa-slider .wa-dots button:hover:not(.on) { background: var(--ink-faint); }

  /* Mockup-nya sengaja tetap terang di dark mode, biar tetap kerasa seperti WhatsApp asli */
  :root[data-resolved="dark"] .wa-slider .wa { background: oklch(0.975 0.006 150); border-color: oklch(0.90 0.01 150); }
  :root[data-resolved="dark"] .wa-slider .wa-head { background: oklch(0.540 0.140 153); }
  :root[data-resolved="dark"] .wa-slider .bub { background: #fff; color: oklch(0.255 0.02 200); }
  :root[data-resolved="dark"] .wa-slider .bub.me { background: oklch(0.88 0.09 150); color: oklch(0.255 0.02 200); }
  :root[data-resolved="dark"] .wa-slider .bub.host { box-shadow: 0 1px 1px oklch(0.3 0.02 250 / .08), inset 0 0 0 1.5px oklch(0.66 0.155 152 / .4); }
  :root[data-resolved="dark"] .wa-slider .bub.bot { background: oklch(0.96 0.025 195); color: oklch(0.255 0.02 200); }
  :root[data-resolved="dark"] .wa-slider .wa-type { background: #fff; color: oklch(0.55 0.02 200); border-top-color: oklch(0.90 0.01 150); }
  :root[data-resolved="dark"] .wa-slider .wa-type .field { background: oklch(0.945 0.012 140); }

